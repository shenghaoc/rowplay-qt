<!DOCTYPE RCC>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Compiled by crates/rowplay-app/build.rs with rcc in binary mode and
     registered from Rust through qtbridge::qresource::register_bytes. Paths are
     relative to this file; the prefix places the module at qrc:/qt/qml/RowPlay.
     The i18n .qm bundles are compiled by build.rs (lrelease) into a second
     rcc blob under the same prefix. -->
<RCC version="1.0">
    <qresource prefix="/qt/qml">
        <file>RowPlay/qmldir</file>
        <file>RowPlay/Main.qml</file>
        <file>RowPlay/SmokeMain.qml</file>
        <file>RowPlay/SettingsScreen.qml</file>
        <file>RowPlay/LiveModePanel.qml</file>
        <file>RowPlay/SidebarPanel.qml</file>
        <file>RowPlay/DashboardScreen.qml</file>
        <file>RowPlay/MetricTile.qml</file>
        <file>RowPlay/DetailScreen.qml</file>
        <file>RowPlay/StrokeAnalysisPanel.qml</file>
        <file>RowPlay/StrokeChart.qml</file>
        <file>RowPlay/ChartUtils.qml</file>
        <file>RowPlay/SmokeScene.qml</file>
        <file>RowPlay/Theme.qml</file>
        <file>RowPlay/Tr.qml</file>
        <file>RowPlay/Icon.qml</file>
        <file>RowPlay/Glyphs.qml</file>
        <file>RowPlay/CommandButton.qml</file>
        <file>RowPlay/FocusRing.qml</file>
        <file>RowPlay/ChartTheme.qml</file>
        <file>RowPlay/AppSlider.qml</file>
        <file>RowPlay/AppBusyIndicator.qml</file>
        <file>RowPlay/Replay/qmldir</file>
        <file>RowPlay/Replay/ReplayScene.qml</file>
        <!-- The vendored replay packs (assets/replay/) are validated against
             their V3 contract and converted to QML components by build.rs
             (balsam) into the generated RowPlay.ReplayAssets module, bundled
             as a separate binary resource; the GLBs themselves are not
             shipped in the app. -->
    </qresource>
    <qresource prefix="/">
        <file>qtquickcontrols2.conf</file>
        <file>+windows/qtquickcontrols2.conf</file>
    </qresource>
</RCC>
