# SPDX-License-Identifier: GPL-3.0-or-later
# Local Qt 6.11.2 for rowplay-app (Phase 5 onward needs a local Qt: the 3D
# scene, materials and athlete must be looked at while building, not inferred
# from CI). Installed per README.md ("Installing Qt locally") at ~/Qt.
#
# With direnv installed, `direnv allow` picks this up automatically.
# Otherwise: `source .envrc` (bash) before cargo commands that need Qt.

if [ -d "$HOME/Qt/6.11.2/gcc_64/bin" ]; then
    export QTDIR="$HOME/Qt/6.11.2/gcc_64"
    export PATH="$QTDIR/bin:$PATH"
    export QMAKE="$QTDIR/bin/qmake"
    export LD_LIBRARY_PATH="$QTDIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
elif [ -d "$HOME/Qt/6.11.2/macos/bin" ]; then
    # macOS framework install (aqt `mac desktop 6.11.2 clang_64`). No
    # DYLD_* variable: build.rs emits the Qt lib dir as an rpath (Phase 9).
    export QTDIR="$HOME/Qt/6.11.2/macos"
    export PATH="$QTDIR/bin:$PATH"
    export QMAKE="$QTDIR/bin/qmake"
fi
# Qt warns about the C locale; the UTF-8 C locale silences it.
export LANG=C.UTF-8
