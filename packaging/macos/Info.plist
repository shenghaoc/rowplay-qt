<!-- Bundle manifest template for rowplay-qt.app; tools/package/macos.sh
     substitutes @VERSION@ (Cargo package version) and @MIN_MACOS@ (the Qt
     install's QMAKE_MACOSX_DEPLOYMENT_TARGET). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>rowplay</string>
    <key>CFBundleExecutable</key>
    <string>rowplay-qt</string>
    <key>CFBundleIconFile</key>
    <string>rowplay-qt.icns</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.shenghaoc.rowplay</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>rowplay</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.healthcare-fitness</string>
    <key>LSMinimumSystemVersion</key>
    <string>@MIN_MACOS@</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>GPL-3.0-or-later. Not affiliated with Concept2.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
